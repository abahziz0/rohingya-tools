{
  "manifest_version": 3,
  "name": "Rohingya Reader — Hanifi to Rohingyalish",
  "description": "Read Hanifi Rohingya webpages in Rohingyalish.",
  "version": "0.0.0",
  "minimum_chrome_version": "120",
  "homepage_url": "https://rohingyalanguage.org/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Rohingya Reader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["*://*/*"]
}
