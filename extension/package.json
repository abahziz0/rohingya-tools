{
  "name": "rohingya-reader-extension",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Rohingya Reader \u2014 read Hanifi Rohingya webpages in Rohingyalish (Chrome extension, Manifest V3).",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs --test && playwright test",
    "icons": "node scripts/render-icons.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "fixtures:serve": "node scripts/serve-fixtures.mjs",
    "check": "npm run typecheck && npm test && npm run package && npm run verify",
    "fixtures": "node scripts/make-fixtures.mjs",
    "examples:snapshot": "node scripts/snapshot-examples.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "homepage": "https://rohingyalanguage.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/abahziz0/rohingya-tools.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/abahziz0/rohingya-tools/issues"
  }
}
